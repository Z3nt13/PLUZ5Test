# Copy to .env and fill in. .env is gitignored -- never commit it.
# This is the ONLY file you edit for local paths; the scripts hold none.

# --- GitHub (used for manifest URLs and local pushes) ---
GH_USER=your-github-name
GH_REPO=your-repo-name
GH_BRANCH=main
# Token: used by PLUZ-AllStar to sign in when pushing (so git never asks you for
# credentials) and for higher API limits in pluz-fetch. Create one at GitHub >
# Settings > Developer settings > Fine-grained tokens, for this repo only, with
# Contents: Read and write AND Workflows: Read and write (the repo holds
# .github/workflows files, and GitHub refuses pushes that touch them without it). GitHub Actions uses its own built-in token.
GH_TOKEN=

# --- Portable tools (Windows). Folders are searched; leave blank to use PATH. ---
PLUZ_PY_DIR=D:\portaz\WinPython-p
PLUZ_GIT_DIR=D:\portaz\Git-p
PLUZ_7ZIP_DIR=D:\portaz\7Zip-p
# Exact files instead of folders (optional, win over the folders above):
PLUZ_PYTHON=
PLUZ_GIT=
# Linux/Arch: leave all PLUZ_* blank to use system python3 / git,
# or set PLUZ_PYTHON=/path/to/python3 and PLUZ_GIT=/path/to/git.

# --- Debug (off by default) ---
# 1 = PLUZ-AllStar prints a settings summary, turns on git tracing and saves
# everything to logs\allstar_debug_<time>.log. Or run: PLUZ-AllStar.bat debug
PLUZ_DEBUG=0

# --- Switches (optional) ---
# PLUZ_DEBUG=1 prints a diagnostic report and saves git traces to logs/.
# Or run: PLUZ-AllStar.bat debug   /   PLUZ-AllStar.bat nodebug
PLUZ_DEBUG=0
# Leave at 0 so git never opens a sign-in pop-up (it fails with a message instead).
PLUZ_ALLOW_PROMPT=0

# --- Mode (optional; default comes from configs/settings.json = source) ---
# source: manifests link to the upstream release files, nothing is stored in your repo.
# hosted: binaries are copied into payloads/ and served from your repo (up to 3 builds each).
# PLUZ_MODE=source
